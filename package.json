{
  "name": "dsh-ghost-input",
  "version": "0.2.4",
  "description": "输入框行内续写：停顿后由当前会话的模型补全半句话，Tab 收下（DeepSeek Harness 插件）",
  "icon": "icon.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ghost-text",
    "inline-completion",
    "composer",
    "autocomplete",
    "model"
  ],
  "author": {
    "name": "困困",
    "url": "https://github.com/KunKun24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunKun24/dsh-ghost-input.git"
  },
  "homepage": "https://github.com/KunKun24/dsh-ghost-input#readme",
  "bugs": {
    "url": "https://github.com/KunKun24/dsh-ghost-input/issues"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
